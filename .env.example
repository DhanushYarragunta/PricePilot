# ============================================================================
# PricePilot configuration
# Copy to .env and fill in real values.  NEVER commit .env.
#   cp .env.example .env
# ============================================================================

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
POSTGRES_DB=pricepilot
POSTGRES_USER=pricepilot
# Generate one:  openssl rand -base64 24
POSTGRES_PASSWORD=change_me_before_deploying

# ---------------------------------------------------------------------------
# Auth
# JWT signing secret. MUST be at least 32 bytes (256 bits) for HS256.
# Generate one:  openssl rand -base64 48
# ---------------------------------------------------------------------------
JWT_SECRET=change_me_to_a_long_random_string_at_least_32_bytes
JWT_TTL_HOURS=72

# ---------------------------------------------------------------------------
# AI provider — secrets are read only by the backend, never by Vite.
# For AgentRouter use openai-compatible and the host/model shown in your account.
# Example for this deployment: https://agentrouter.org/v1 with gpt-6.1-sol.
# Set AI_MODEL=gpt-6-astra to select Astra; no silent model fallback is used.
# ---------------------------------------------------------------------------
AI_PROVIDER=openai-compatible
AI_API_KEY=
AI_BASE_URL=https://agentrouter.org/v1
AI_MODEL=gpt-6.1-sol
AI_MAX_TOKENS=4096
AI_REASONING_EFFORT=low
AI_TIMEOUT_MS=45000
# Atomic request limit for compatible providers, including failed attempts/retries.
AI_MONTHLY_CALL_BUDGET=100
# Supply your gateway's rates to estimate spend. Blank means unknown, not zero.
# Without rates, only the request limit bounds usage; check the provider dashboard.
AI_INPUT_USD_PER_MILLION=
AI_OUTPUT_USD_PER_MILLION=
AI_CACHED_INPUT_USD_PER_MILLION=
# Estimated spending ceiling; checked before requests, so in-flight calls may exceed it.
AI_MONTHLY_BUDGET_USD=5.00
# Optional legacy provider: AI_PROVIDER=anthropic. Clear generic AI_* credentials,
# base URL and model above before using these Anthropic settings.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
ANTHROPIC_BASE_URL=https://api.anthropic.com

# ---------------------------------------------------------------------------
# Tavily  (https://tavily.com)  — used ONLY to discover which other retailers
# sell a product. Never used as a price source.
# Leave blank to disable cross-retailer discovery; the rest of the app works.
# ---------------------------------------------------------------------------
TAVILY_API_KEY=
TAVILY_MONTHLY_CALL_BUDGET=500

# ---------------------------------------------------------------------------
# Scraping
# ---------------------------------------------------------------------------
# Legacy unblocker settings, retained for compatibility. Price scraping ignores
# these values and never uses a direct-fetch or alternate-provider fallback.
SCRAPER_PROVIDER=none
SCRAPER_API_KEY=
# Unused by BrowserAct; its separate submission limit is configured below.
SCRAPER_MONTHLY_CALL_BUDGET=800

# Global politeness settings. Lower = gentler on retailers, and the reason
# your IP does not get banned. Do not raise these casually.
SCRAPE_MIN_DELAY_MS=4000
SCRAPE_MAX_CONCURRENCY=2
SCRAPE_TIMEOUT_MS=20000

# ---------------------------------------------------------------------------
# Email alerts (optional). If blank, alerts are recorded in the DB and logged
# but not emailed — the app still runs.
# For Gmail use an App Password, not your account password.
# ---------------------------------------------------------------------------
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=PricePilot <noreply@example.com>

# ---------------------------------------------------------------------------
# Public URL of the deployed frontend, used for CORS and for links in emails.
# Comma-separate multiple origins.
#
# On a real deployment both of these become your site's own address — e.g.
# https://pricepilot.example.com — because nginx serves the React app and
# proxies /api from the same origin. Leaving them at localhost means alert
# emails contain links that only work on your laptop.
# ---------------------------------------------------------------------------
APP_PUBLIC_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ---------------------------------------------------------------------------
# Registration lock. Set a value here and new signups must supply it as
# `inviteCode`. Strongly recommended once the site is public, so strangers
# cannot run up your Claude bill.
# ---------------------------------------------------------------------------
SIGNUP_INVITE_CODE=

# ===========================================================================
# Deployment — only read by docker-compose.yml
# ===========================================================================

# ---------------------------------------------------------------------------
# The hostname nginx answers on, and whether it serves HTTPS.
#
# Start with TLS_ENABLED=false. The site comes up on plain HTTP immediately,
# which is what you want while you confirm everything else works. Then point a
# domain's A record at this instance's public IP, run
# ./deploy/init-letsencrypt.sh, set TLS_ENABLED=true and recreate app/web using
# README.md. A restart does not load changed environment values.
#
# A certificate cannot be issued for an ec2-*.compute.amazonaws.com hostname —
# Let's Encrypt refuses to sign names it does not control — so HTTPS needs a
# domain you own. HTTP mode is for bootstrap or an external TLS terminator;
# use HTTPS before signing in on a public deployment.
# ---------------------------------------------------------------------------
DOMAIN=localhost
TLS_ENABLED=false
# Where Let's Encrypt sends expiry warnings. Used only by init-letsencrypt.sh.
CERTBOT_EMAIL=

# ---------------------------------------------------------------------------
# Runtime knobs you may want on a live box.
# ---------------------------------------------------------------------------
# Set to false to stop all automatic retailer checks without stopping the app.
# This is the switch to reach for if you ever suspect the scraper is misbehaving:
# the site stays up and serves the prices it already has.
SCHEDULER_ENABLED=true
# One verified observation can serve multiple callers; manual refreshes still cap reuse at 60s.
SCRAPE_FRESHNESS_SECONDS=900
SCRAPE_CACHE_MAX_ENTRIES=2000
# Metrics deadline: next scheduled check time plus this allowance.
SCHEDULER_FRESHNESS_GRACE_SECONDS=300
SCHEDULER_SHUTDOWN_GRACE_SECONDS=400
# run-local.sh uses the dev profile; leave automatic paid checks off until deliberately enabled.
DEV_SCHEDULER_ENABLED=false

# Manual refresh requests use a bounded background queue. Polling never starts a new scrape.
MANUAL_REFRESH_WORKERS=1
MANUAL_REFRESH_QUEUE_CAPACITY=8
MANUAL_REFRESH_MAX_JOBS=200
MANUAL_REFRESH_RETENTION_SECONDS=3600
MANUAL_REFRESH_SHUTDOWN_GRACE_SECONDS=400
# Same-phase background drains run together. Separate web/background phases need this ceiling.
# An idle shutdown returns promptly; these values apply when work is still in flight.
SHUTDOWN_TIMEOUT=420s
STOP_GRACE_PERIOD=900s

# Optional CloudWatch custom metrics. Disabled unless this profile is explicitly selected.
# Use cloudwatch, or dev,cloudwatch when deliberately enabling it during development.
# Set namespace/region for your AWS account; there is no fallback namespace or region.
# Use an EC2 instance role with CloudWatch PutMetricData permission. No static AWS keys.
SPRING_PROFILES_ACTIVE=
CLOUDWATCH_NAMESPACE=
AWS_REGION=
CLOUDWATCH_STEP=60s

# Hikari pool size. 8 is sized for a t3.small against max_connections=40.
DB_POOL_MAX=8

# Raise to DEBUG when diagnosing an extraction problem — it logs every fetch and
# every strategy attempt. Leave at INFO otherwise; DEBUG fills the log volume in
# a day or two.
LOG_LEVEL=INFO


# BrowserAct is the only price scraper. Shared workflow setup: README.md (BrowserAct workflow).
# API credentials belong only in the backend environment. A workflow ID is not a bot credential ID.
BROWSERACT_API_KEY=
# One existing published workflow shared by every supported retailer. Input: url.
BROWSERACT_WORKFLOW_ID=
BROWSERACT_TIMEOUT_MS=90000
# Zero keeps paid submissions disabled until the workflow and credit usage are approved.
# This caps workflow submissions per UTC month, not the provider's variable credit cost.
# Set -1 for unlimited submissions with usage still tracked; provider charges still apply.
BROWSERACT_MONTHLY_CALL_BUDGET=0

# Evidence research and buying plans (no extra BrowserAct submissions).
RESEARCH_MAX_SEARCHES=6
RESEARCH_TIMEOUT_SECONDS=65
RESEARCH_CACHE_HOURS=24
RESEARCH_MAX_SOURCES=16
PLANNING_MIN_FORECAST_OBSERVATIONS=12
PLANNING_MIN_FORECAST_DAYS=7
PLANNING_MAX_FORECAST_DAYS=30
PLANNING_STALE_AFTER_HOURS=24
PLANNING_GAP_AFTER_HOURS=48
PLANNING_REASSESS_AFTER_HOURS=24
PLANNING_DEADLINE_RISK_DAYS=3
PLANNING_MIN_SAVINGS_PERCENT=3
PLANNING_MAX_BACKTEST_ERROR_PERCENT=15
PLANNING_MIN_COVERAGE_PERCENT=50
PLANNING_SCHEDULER_BATCH_SIZE=20
PLANNING_AI_TIMEOUT_SECONDS=15
PLANNING_ZONE_ID=Asia/Kolkata
