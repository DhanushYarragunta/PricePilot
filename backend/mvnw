#!/bin/sh
# Maven Wrapper script
# Automatically downloads and runs the correct Maven version

set -e

MAVEN_PROJECTBASEDIR="${MAVEN_BASEDIR:-$(cd "$(dirname "$0")" && pwd)}"
MAVEN_WRAPPER_JAR="$MAVEN_PROJECTBASEDIR/.mvn/wrapper/maven-wrapper.jar"
MAVEN_WRAPPER_PROPERTIES="$MAVEN_PROJECTBASEDIR/.mvn/wrapper/maven-wrapper.properties"

# Determine distribution URL
if [ -r "$MAVEN_WRAPPER_PROPERTIES" ]; then
    distributionUrl=$(grep 'distributionUrl' "$MAVEN_WRAPPER_PROPERTIES" | cut -d'=' -f2-)
fi
distributionUrl="${distributionUrl:-https://repo.maven.apache.org/maven2/org/apache/maven/apache-maven/3.9.6/apache-maven-3.9.6-bin.zip}"

MAVEN_HOME="$HOME/.m2/wrapper/dists/$(basename "$distributionUrl" .zip)"

if [ ! -d "$MAVEN_HOME" ]; then
    echo "Downloading Maven..."
    mkdir -p "$MAVEN_HOME"
    tmpFile="$(mktemp /tmp/maven-wrapper-XXXXXX.zip)"
    curl -sL "$distributionUrl" -o "$tmpFile"
    unzip -qo "$tmpFile" -d "$MAVEN_HOME"
    rm -f "$tmpFile"
fi

MAVEN_EXEC=$(find "$MAVEN_HOME" -name mvn -type f -path "*/bin/mvn" | head -1)

if [ -z "$MAVEN_EXEC" ]; then
    echo "Error: Could not find mvn executable in $MAVEN_HOME" >&2
    exit 1
fi

chmod +x "$MAVEN_EXEC"
exec "$MAVEN_EXEC" "$@"
